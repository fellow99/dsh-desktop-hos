diff --git a/packages/fs/fs-local/src/remove.ts b/packages/fs/fs-local/src/remove.ts
new file mode 100644
index 0000000000..52e9580c7e
--- /dev/null
+++ b/packages/fs/fs-local/src/remove.ts
@@ -0,0 +1,49 @@
+/**
+ * Raw removal mechanics for the local `ctx.fs` backend. Kept beside
+ * `fsio.ts` rather than inside it so a sandbox-fenced removal composes with the
+ * read/write/edit primitives without widening the atomic-write module.
+ * @module @deepseek-ai/dsh-fs-local/remove
+ */
+
+import type { Stats } from 'node:fs'
+import { lstat, rm } from 'node:fs/promises'
+import { FsError } from '@deepseek-ai/dsh-fs'
+
+/**
+ * Remove a file or directory after probing the entry, so an absent path reports
+ * the seam's `FS_NOT_FOUND` rather than a raw Node errno. The entry is probed
+ * without following the final symlink, so removing a link removes the link
+ * itself; without `recursive`, a non-empty directory fails loudly instead of
+ * being silently emptied.
+ * @param absolutePath - the canonical path to remove (typically a target key).
+ * @param recursive - permit removing a directory together with its contents.
+ * @param signal - aborts before the removal (`FS_ABORTED`).
+ * @returns whether the removed entry was a regular file or a directory.
+ */
+export async function removePath(
+  absolutePath: string,
+  recursive: boolean,
+  signal?: AbortSignal,
+): Promise<'file' | 'directory'> {
+  if (signal?.aborted) throw new FsError('remove aborted', 'FS_ABORTED')
+  const info = await lstatAbsentAsNull(absolutePath)
+  if (info === null) throw new FsError(`cannot remove "${absolutePath}": not found`, 'FS_NOT_FOUND')
+  await rm(absolutePath, { recursive, force: false })
+  return info.isDirectory() ? 'directory' : 'file'
+}
+
+/**
+ * `lstat` an entry, reporting an absent path or absent parent segment as null so
+ * the caller raises the seam's structured `FS_NOT_FOUND`.
+ * @param absolutePath - the path entry to inspect with `lstat` semantics.
+ * @returns the entry metadata, or null when it does not exist.
+ */
+async function lstatAbsentAsNull(absolutePath: string): Promise<Stats | null> {
+  try {
+    return await lstat(absolutePath)
+  } catch (error: unknown) {
+    const code = (error as NodeJS.ErrnoException | null)?.code
+    if (code === 'ENOENT' || code === 'ENOTDIR') return null
+    throw error
+  }
+}
